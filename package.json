{
  "name": "edex-desktop-organizer",
  "productName": "eDEX Desktop Organizer",
  "version": "1.2.1",
  "description": "Desktop organizer using the eDEX-UI sci-fi HUD layout",
  "main": "main.js",
  "author": "bananamax9113",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReXx09/Bockis-eDEX_Desktop_UI.git"
  },
  "scripts": {
    "test": "node --test test/organizer.test.js",
    "prepare-assets": "node scripts/prepare-assets.js",
    "prestart": "node scripts/prepare-assets.js",
    "start": "electron .",
    "rebuild-native": "electron-rebuild -f -w node-pty",
    "predist": "npm run rebuild-native && node scripts/prepare-assets.js",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.edex.desktop-organizer",
    "productName": "eDEX Desktop Organizer",
    "copyright": "Copyright © eDEX Desktop Organizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": true,
    "forceCodeSigning": false,
    "artifactName": "eDEX-Desktop-Organizer-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "eDEX Desktop Organizer",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_TW",
        "en_US"
      ],
      "language": "1028"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ReXx09",
        "repo": "Bockis-eDEX_Desktop_UI"
      }
    ]
  },
  "allowScripts": {
    "electron@44.7.0": true
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
